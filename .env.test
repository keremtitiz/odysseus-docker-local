# Odysseus Docker test ortamı — .env üzerine yazılan test ayarları.
# odysseus-test.sh, resmi akıştaki gibi upstream/.env.example -> upstream/.env
# kopyalar ve ardından bu dosyadaki değerleri ekler.
# GİZLİ BİLGİ KOYMAYIN: admin parolası çalışma anında rastgele üretilir
# ve yalnızca upstream/.env içinde (chmod 600, git dışı) tutulur.

COMPOSE_PROJECT_NAME=odysseus-test

# Yalnızca loopback; dokümandaki varsayılan host portu.
APP_BIND=127.0.0.1
APP_PORT=7011

AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ODYSSEUS_ADMIN_USER=admin

# Belirli bir imajı test etmek için açın (ör. ghcr.io/odysseus-dev/odysseus:1.0.2-7c8070f)
# ODYSSEUS_IMAGE=ghcr.io/odysseus-dev/odysseus:latest
